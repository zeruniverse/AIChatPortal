{
  "host": "0.0.0.0",
  "port": 3000,
  "auth": {
    "sessionSecret": "replace-with-at-least-32-random-characters",
    "cookieName": "chat_session",
    "legacyOwnerId": "user-1",
    "users": [
      {
        "id": "user-1",
        "label": "用户一",
        "token": "replace-with-a-long-user-token-1"
      },
      {
        "id": "user-2",
        "label": "用户二",
        "token": "replace-with-a-long-user-token-2"
      }
    ]
  },
  "provider": {
    "url": "https://provider.example.com/v1/chat/completions",
    "key": "replace-with-provider-key",
    "headers": {},
    "extraBody": {}
  },
  "models": [
    { "id": "model-a", "label": "模型 A" },
    { "id": "model-b", "label": "模型 B" }
  ],
  "limits": {
    "maxConcurrentTasks": 10,
    "maxCompressedAttachmentBytes": 70000000,
    "maxRawUploadBytesPerTurn": 0,
    "maxFilesPerTurn": 100
  },
  "cleanup": {
    "maxChatBytes": 3000000000,
    "pressureAgeHours": 24,
    "maxAgeDays": 7,
    "orphanUploadHours": 24,
    "intervalMinutes": 10
  }
}
